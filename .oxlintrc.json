{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/no-underscore-dangle": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unsafe-enum-assignment": "off"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/**"]
}
